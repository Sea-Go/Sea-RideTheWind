type (
	BuildEnvelope {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
		Data Build  `json:"data"`
	}
	CompileEnvelope {
		Code int     `json:"code"`
		Msg  string  `json:"msg"`
		Data Compile `json:"data"`
	}
	ListModulesRespEnvelope {
		Code int             `json:"code"`
		Msg  string          `json:"msg"`
		Data ListModulesResp `json:"data"`
	}
	ListRevisionsRespEnvelope {
		Code int               `json:"code"`
		Msg  string            `json:"msg"`
		Data ListRevisionsResp `json:"data"`
	}
	ModuleEnvelope {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
		Data Module `json:"data"`
	}
	ReceiptEnvelope {
		Code int     `json:"code"`
		Msg  string  `json:"msg"`
		Data Receipt `json:"data"`
	}
	ReleaseEnvelope {
		Code int     `json:"code"`
