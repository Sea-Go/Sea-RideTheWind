# Copy to .env on deployment hosts and fill real secrets.
PUBLIC_HOST=
DOCKER_NETWORK=Sea-TryGo
CONTAINER_PREFIX=Sea

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=first_db
POSTGRES_ADDR=postgres
POSTGRES_PORT=5432

ETCD_ADDR=etcd:2379
REDIS_ADDR=redis:6379
KAFKA_ADDR=kafka:9092
MINIO_ADDR=minio:9000
BEANSTALKD1_ADDR=beanstalkd1:11300
BEANSTALKD2_ADDR=beanstalkd2:11300
OTEL_ADDR=jaeger:4317

# 面板与中间件凭据（compose 引用；带默认值者可省略，NEO4J 必填）
NEO4J_PASSWORD=change-me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
